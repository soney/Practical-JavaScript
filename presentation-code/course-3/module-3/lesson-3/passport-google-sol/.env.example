# Copy this file to ".env" and fill in the values from the Google Cloud Console.
#
# 1. Go to https://console.cloud.google.com/ and create (or pick) a project.
# 2. APIs & Services > Credentials > Create Credentials > OAuth client ID.
# 3. Application type: "Web application".
# 4. Add this Authorized redirect URI:
#       http://localhost:3000/auth/google/callback
# 5. Copy the Client ID and Client Secret it gives you into the lines below.

GOOGLE_CLIENT_ID=your-client-id-here
GOOGLE_CLIENT_SECRET=your-client-secret-here

# Any random string. Used to sign the session cookie.
SESSION_SECRET=change-this-secret-in-a-real-app
