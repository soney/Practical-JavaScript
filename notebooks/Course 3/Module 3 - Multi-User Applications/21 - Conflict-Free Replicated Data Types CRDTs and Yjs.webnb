    ```{javascript}
    const start = [
      { character: 'c', position: 0 },
      { character: 'a', position: 50 },
      { character: 't', position: 100 }
    ];

    function applyOp(characters, op) {
      const result = [];

      // TODO: copy across every character except one being deleted at
      // op.position. If this is an insert, put the new character in the
      // place its position calls for, rather than at the end.

      return result;
    }

    function render(characters) {
      let text = '';

      for (const item of characters) {
        text = text + item.character;
      }

      return text;
    }

    const deleteC = { type: 'delete', position: 0 };
    const insertR = { type: 'insert', character: 'r', position: 75 };

    console.log(render(applyOp(applyOp(start, deleteC), insertR)));
    console.log(render(applyOp(applyOp(start, insertR), deleteC)));
    ```
    ```+solution
    const start = [
      { character: 'c', position: 0 },
      { character: 'a', position: 50 },
      { character: 't', position: 100 }
    ];

    function applyOp(characters, op) {
      const result = [];

      for (const item of characters) {
        if (!(op.type === 'delete' && item.position === op.position)) {
          result.push(item);
        }
      }

      if (op.type === 'insert') {
        // Walking backwards leaves insertAt at the first greater position.
        let insertAt = result.length;

        for (let i = result.length - 1; i >= 0; i--) {
          if (result[i].position > op.position) {
            insertAt = i;
          }
        }

        result.splice(insertAt, 0, { character: op.character, position: op.position });
      }

      return result;
    }

    function render(characters) {
      let text = '';

      for (const item of characters) {
        text = text + item.character;
      }

      return text;
    }

    const deleteC = { type: 'delete', position: 0 };
    const insertR = { type: 'insert', character: 'r', position: 75 };

    console.log(render(applyOp(applyOp(start, deleteC), insertR)));
    console.log(render(applyOp(applyOp(start, insertR), deleteC)));
    ```
    ```+test
    wrap(render(applyOp(start, deleteC))).should('equal', 'at').run('Deleting the character at position 0 should leave `at`', 'Applied a delete');
    wrap(render(applyOp(start, insertR))).should('equal', 'cart').run('Inserting `r` at position 75 should give `cart`, because 75 falls between the `a` at 50 and the `t` at 100', 'Applied an insert');
    wrap(render(applyOp(applyOp(start, deleteC), insertR))).should('equal', 'art').run('Delete then insert should give `art`', 'One order converged');
    wrap(render(applyOp(applyOp(start, insertR), deleteC))).should('equal', 'art').run('Insert then delete should give `art` as well. Sorting by position is what makes the order irrelevant', 'Both orders converged');
    ```

2. Complete `merge` so two replicas combine without losing either side's change.

    ```{javascript}
    const original = { theme: 'light', fontSize: 12, language: 'en' };

    const fromAmara = { theme: 'dark', fontSize: 12, language: 'en' };
    const fromBen = { theme: 'light', fontSize: 16, language: 'en' };

    function merge(base, first, second) {
      const result = {};

      for (const key of ['theme', 'fontSize', 'language']) {
        // TODO: if the first replica changed this key from the base, keep
        // its value; otherwise if the second replica changed it, keep
        // that; otherwise keep the base value
      }

      return result;
    }

    console.log(merge(original, fromAmara, fromBen));
    console.log(merge(original, fromBen, fromAmara));
    ```
    ```+solution
    const original = { theme: 'light', fontSize: 12, language: 'en' };

    const fromAmara = { theme: 'dark', fontSize: 12, language: 'en' };
    const fromBen = { theme: 'light', fontSize: 16, language: 'en' };

    function merge(base, first, second) {
      const result = {};

      for (const key of ['theme', 'fontSize', 'language']) {
        if (first[key] !== base[key]) {
          result[key] = first[key];
        } else if (second[key] !== base[key]) {
          result[key] = second[key];
        } else {
          result[key] = base[key];
        }
      }

      return result;
    }

    console.log(merge(original, fromAmara, fromBen));
    console.log(merge(original, fromBen, fromAmara));
    ```
    ```+test
    wrap(merge(original, fromAmara, fromBen)).should('equal', { theme: 'dark', fontSize: 16, language: 'en' }).run('Both changes should survive: Amara changed the theme and Ben changed the font size, and nobody touched the language', 'Kept both changes');
    wrap(merge(original, fromBen, fromAmara)).should('equal', { theme: 'dark', fontSize: 16, language: 'en' }).run('Swapping the order of the replicas should not change the result. Compare each replica against the base, not against each other', 'The merge is order-independent');
    wrap(merge(original, { theme: 'light', fontSize: 12, language: 'en' }, fromBen)).should('equal', { theme: 'light', fontSize: 16, language: 'en' }).run('When the first replica did not change a key, the second replica\'s change should still come through', 'Fell through to the second replica');
    ```

3. Set up a Yjs document bound to a Quill editor. The imports are done for you.

    ```{node}
    // Stand-ins for the libraries.
    function Doc() {
      const doc = { texts: {} };

      doc.getText = function (name) {
        if (!doc.texts[name]) {
          doc.texts[name] = { name: name };
        }

        return doc.texts[name];
      };

      return doc;
    }

    const created = { provider: null, binding: null };

    function WebrtcProvider(roomName, ydoc) {
      created.provider = { roomName: roomName, ydoc: ydoc };

      return created.provider;
    }

    function QuillBinding(ytext, quill) {
      created.binding = { ytext: ytext, quill: quill };

      return created.binding;
    }

    const quill = { name: 'the editor' };

    // TODO: create the shared document, connect it over WebRTC using the room
    // name 'my-yjs-quill-room', get the text named 'quill' out of the
    // document, and bind that text to the editor.

    console.log(created.provider.roomName, created.binding.ytext.name);
    ```
    ```+solution
    // Stand-ins for the libraries.
    function Doc() {
      const doc = { texts: {} };

      doc.getText = function (name) {
        if (!doc.texts[name]) {
          doc.texts[name] = { name: name };
        }

        return doc.texts[name];
      };

      return doc;
    }

    const created = { provider: null, binding: null };

    function WebrtcProvider(roomName, ydoc) {
      created.provider = { roomName: roomName, ydoc: ydoc };

      return created.provider;
    }

    function QuillBinding(ytext, quill) {
      created.binding = { ytext: ytext, quill: quill };

      return created.binding;
    }

    const quill = { name: 'the editor' };

    const ydoc = new Doc();

    const provider = new WebrtcProvider('my-yjs-quill-room', ydoc);

    const ytext = ydoc.getText('quill');

    const binding = new QuillBinding(ytext, quill);

    console.log(created.provider.roomName, created.binding.ytext.name);
    ```
    ```+test
    wrap(created.provider && created.provider.roomName).should('equal', 'my-yjs-quill-room').run('Create the provider with the room name `my-yjs-quill-room`; peers using the same name share the document', 'Connected to the room');
    wrap(created.provider && created.provider.ydoc === ydoc).should('equal', true).run('Pass the shared document to the provider, so it is the thing being synchronized', 'Connected the right document');
    wrap(created.binding && created.binding.ytext.name).should('equal', 'quill').run('Get the text with `ydoc.getText(\'quill\')` and bind that, since a document can hold several shared values', 'Bound the right shared text');
    wrap(created.binding && created.binding.quill === quill).should('equal', true).run('Bind the shared text to the editor with `new QuillBinding(ytext, quill)`', 'Bound the editor');
    ```

4. Two rooms

    ```{mcq}
    You run the shared editor, and a friend runs the same code, but she typed `'my-yjs-quill-r00m'` as her room name where yours says `'my-yjs-quill-room'`. What happens?
    correct: Correct! The room name is how the provider finds peers: same name, same document. With different names you are in different rooms, so both editors work normally and never see each other.
    wrong: Neither editor breaks. Think about what the provider uses the room name for.
    [x] Both editors work normally, but you are in different rooms and never sync
    [ ] The provider throws an error, because her room does not exist yet
    [ ] Her changes arrive in your editor, but yours do not reach hers
    [ ] The two rooms merge once the signaling server notices the names are similar
    ```

5. What the proof buys you

    ```{mcq}
    Two peers apply the same two changes in opposite orders and still end with identical documents, with no server choosing an order. What makes that work?
    correct: Correct! A CRDT is designed, and mathematically proven, so that every order of the same changes converges on the same result. OT reaches agreement the other way: a central server picks one order and transforms operations to fit it.
    wrong: Nothing here timestamps, relays, or reorders the changes. The guarantee lives in the data structure itself.
    [x] The data structure is designed so that any order of the same changes gives the same result
    [ ] WebRTC guarantees that every peer receives messages in the same order
    [ ] The newest change always overwrites the older one
    [ ] The signaling server sorts the changes before forwarding them
    ```

