    };

    const sent = [];

    function handleSignal(message) {
      // TODO:
      //   an offer     -> set message.offer as the remote description,
      //                   create an answer, set that as the local
      //                   description, and push 'answer' onto sent
      //   an answer    -> set message.answer as the remote description
      //   a candidate  -> add message.candidate to the peer connection
    }

    handleSignal({ type: 'offer', offer: { type: 'offer' } });
    handleSignal({ type: 'candidate', candidate: 'route-1' });

    console.log(peerConnection.remote, peerConnection.local, peerConnection.candidates, sent);
    ```
    ```+solution
    const peerConnection = { local: null, remote: null, candidates: [] };

    peerConnection.setLocalDescription = function (description) {
      peerConnection.local = description.type;
    };

    peerConnection.setRemoteDescription = function (description) {
      peerConnection.remote = description.type;
    };

    peerConnection.createAnswer = function () {
      return { type: 'answer' };
    };

    peerConnection.addIceCandidate = function (candidate) {
      peerConnection.candidates.push(candidate);
    };

    const sent = [];

    function handleSignal(message) {
      if (message.type === 'offer') {
        peerConnection.setRemoteDescription(message.offer);

        const answer = peerConnection.createAnswer();

        peerConnection.setLocalDescription(answer);

        sent.push('answer');
      } else if (message.type === 'answer') {
        peerConnection.setRemoteDescription(message.answer);
      } else if (message.type === 'candidate') {
        peerConnection.addIceCandidate(message.candidate);
      }
    }

    handleSignal({ type: 'offer', offer: { type: 'offer' } });
    handleSignal({ type: 'candidate', candidate: 'route-1' });

    console.log(peerConnection.remote, peerConnection.local, peerConnection.candidates, sent);
    ```
    ```+test
    wrap(peerConnection.remote).should('equal', 'offer').run('An incoming offer describes the other side, so `message.offer` becomes the remote description', 'Stored the remote description');
    wrap(peerConnection.local).should('equal', 'answer').run('The answer you create describes your own side, so it becomes the local description', 'Stored the local description');
    wrap(sent).should('equal', ['answer']).run('The answer has to be sent back through the signaling server', 'Sent the answer back');
    wrap(peerConnection.candidates).should('equal', ['route-1']).run('A candidate message should be added with `addIceCandidate(message.candidate)`', 'Added the candidate');
    wrap((function () { handleSignal({ type: 'answer', answer: { type: 'answer' } }); return peerConnection.remote; })()).should('equal', 'answer').run('An incoming answer becomes the remote description too, and needs no reply', 'Handled an incoming answer');
    ```

3. Put the caller's half of the handshake in order.

    ```{javascript}
    // The steps of starting a call, scrambled. Reorder the lines of this
    // array so the steps happen in the right order.
    const callerSteps = [
      'send the offer through the signaling server',
      'create the RTCPeerConnection',
      'set the answer as the remote description',
      'create an offer',
      'set the offer as the local description',
      'receive an answer back'
    ];

    console.log(callerSteps);
    ```
    ```+solution
    const callerSteps = [
      'create the RTCPeerConnection',
      'create an offer',
      'set the offer as the local description',
      'send the offer through the signaling server',
      'receive an answer back',
      'set the answer as the remote description'
    ];

    console.log(callerSteps);
    ```
    ```+test
    wrap(callerSteps[0]).should('equal', 'create the RTCPeerConnection').run('Nothing can happen before there is a peer connection for it to happen to', 'Started with the peer connection');
    wrap(callerSteps.indexOf('set the offer as the local description') < callerSteps.indexOf('send the offer through the signaling server')).should('equal', true).run('Create it, remember it locally, send it: the offer is saved as the local description before it goes out', 'Saved the offer before sending it');
    wrap(callerSteps).should('equal', ['create the RTCPeerConnection', 'create an offer', 'set the offer as the local description', 'send the offer through the signaling server', 'receive an answer back', 'set the answer as the remote description']).run('Follow the click handler in `main.js` from top to bottom, then the `answer` branch of the message listener', 'Put the whole handshake in order');
    ```

4. Where the traffic flows once the call is up

    ```{mcq}
    Two browsers finish the handshake and begin exchanging video. Which machines is that video passing through?
    correct: Correct! It travels directly between the two browsers. The signaling server and the STUN server were only needed to set the connection up, and both have dropped out. (A TURN relay would carry it, but only as a fallback when no direct route exists.)
    wrong: Think about what the signaling server and the STUN server were each for. Both jobs end once the connection is established.
    [x] None: it travels directly between the two browsers
    [ ] The signaling server, which keeps forwarding everything between them
    [ ] The STUN server, which streams it between the two networks
    [ ] Google's servers, because the configuration named `stun.l.google.com`
    ```

