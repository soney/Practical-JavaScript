    ```+solution
    function makeFakeRequest(method, url, chunks) {
      const listeners = {};

      const request = { method: method, url: url };

      request.on = function (eventName, callback) {
        listeners[eventName] = callback;
      };

      request.deliver = function () {
        for (const chunk of chunks) {
          if (listeners.data) {
            listeners.data(chunk);
          }
        }

        if (listeners.end) {
          listeners.end();
        }
      };

      return request;
    }

    function makeFakeResponse() {
      const sent = { statusCode: null, headers: null, body: '' };

      sent.writeHead = function (code, headers) {
        sent.statusCode = code;
        sent.headers = headers;
      };

      sent.end = function (text) {
        sent.body = text;
      };

      return sent;
    }

    function handleRequest(request, response) {
      let body = '';

      request.on('data', (chunk) => {
        body += chunk.toString();
      });

      request.on('end', () => {
        response.writeHead(200, { 'Content-Type': 'text/plain' });
        response.end(body);
      });
    }

    const request = makeFakeRequest('POST', '/submit_form', ['first=Ja', 'ne&last=Doe']);
    const response = makeFakeResponse();

    handleRequest(request, response);
    request.deliver();

    console.log(response.statusCode + ' ' + response.body);
    ```
    ```+test
    wrap(response.statusCode).should('equal', 200).run('Answer with a `200` status once the body has arrived', 'Sent a success status');
    wrap(response.body).should('equal', 'first=Jane&last=Doe').run('The response body should be the whole request body, `first=Jane&last=Doe`. Add each chunk to `body` in the `data` listener', 'Assembled the whole body');
    wrap(/on\s*\(\s*['"]end['"]/.test(source)).should('equal', true).run('Respond inside the `end` listener, which is the only point at which the body is complete', 'Responded at the end of the stream');
    ```

2. Complete the handler so a `POST` is acknowledged, a `GET` gets the page, and any other method is refused.

    ```{node}
    function makeFakeResponse() {
      const sent = { statusCode: null, headers: null, body: '' };

      sent.writeHead = function (code, headers) {
        sent.statusCode = code;
        sent.headers = headers;
      };

      sent.end = function (text) {
        sent.body = text;
      };

      return sent;
    }

    function handleRequest(request, response) {
      // TODO:
      //   POST -> 200, body 'Received POST request'
      //   GET  -> 200, body '<h1>Home</h1>'
      //   anything else -> 405, body 'Method not allowed'
      //   Content-Type text/plain for the first and third, text/html for the second.
    }

    const posted = makeFakeResponse();
    handleRequest({ method: 'POST', url: '/submit_form' }, posted);

    console.log(posted.statusCode + ' ' + posted.body);
    ```
    ```+solution
    function makeFakeResponse() {
      const sent = { statusCode: null, headers: null, body: '' };

      sent.writeHead = function (code, headers) {
        sent.statusCode = code;
        sent.headers = headers;
      };

      sent.end = function (text) {
        sent.body = text;
      };

      return sent;
    }

    function handleRequest(request, response) {
      if (request.method === 'POST') {
        response.writeHead(200, { 'Content-Type': 'text/plain' });
        response.end('Received POST request');
      } else if (request.method === 'GET') {
        response.writeHead(200, { 'Content-Type': 'text/html' });
        response.end('<h1>Home</h1>');
      } else {
        response.writeHead(405, { 'Content-Type': 'text/plain' });
        response.end('Method not allowed');
      }
    }

    const posted = makeFakeResponse();
    handleRequest({ method: 'POST', url: '/submit_form' }, posted);

    console.log(posted.statusCode + ' ' + posted.body);
    ```
    ```+test
    wrap(posted.statusCode + '|' + posted.body).should('equal', '200|Received POST request').run('A `POST` should answer `200` with the body `Received POST request`', 'Handled the POST');
    wrap((function () { const r = makeFakeResponse(); handleRequest({ method: 'GET', url: '/' }, r); return r.statusCode + '|' + r.body; })()).should('equal', '200|<h1>Home</h1>').run('A `GET` should answer `200` with the page', 'Handled the GET');
    wrap((function () { const r = makeFakeResponse(); handleRequest({ method: 'PUT', url: '/' }, r); return r.statusCode + '|' + r.body; })()).should('equal', '405|Method not allowed').run('Any other method should answer `405 Method Not Allowed`, which says the URL exists but the method is not supported', 'Refused the unsupported method');
    wrap((function () { const r = makeFakeResponse(); handleRequest({ method: 'GET', url: '/' }, r); return r.headers && r.headers['Content-Type']; })()).should('equal', 'text/html').run('The page should be sent as `text/html`', 'Set the content type for the page');
    ```

3. Responding at the wrong moment.

    ```{mcq}
    A handler answers a `POST` from inside the `data` listener:

    ~~~js
    let body = '';

    request.on('data', (chunk) => {
      body += chunk.toString();
      response.end('got ' + body);
    });
    ~~~

    The body arrives as two chunks, `first=Ja` and then `ne&last=Doe`. What does the client receive?
    correct: Correct! `response.end` sends the response and finishes it, and here it runs on the first chunk, when `body` is only `first=Ja`. The complete body exists only once `end` fires, which is why the response belongs in the `end` listener.
    wrong: The response goes out the first time `response.end` runs. How much of the body has arrived at that moment?
    [x] `got first=Ja`
    [ ] `got first=Jane&last=Doe`
    [ ] Nothing, because responses cannot be sent from inside a listener
    [ ] An error page, because `body` is not defined yet
    ```

4. Predicting the body.

    ```{mcq}
    A form has three text inputs: one with `name="food"` where the user types `pizza`, one with `name="drink"` where the user types `water`, and one with `name="notes"` that the user leaves empty. What has the server collected once `end` fires?
    correct: Correct! Each input contributes `name=value` with the pairs joined by `&`, and an empty input still contributes its key, with nothing after the `=`.
    wrong: Every named input contributes a pair, filled in or not, and the pairs are joined with `&`. Look back at "What the Body Looks Like".
    [x] `food=pizza&drink=water&notes=`
    [ ] `food=pizza&drink=water`
    [ ] `{"food": "pizza", "drink": "water", "notes": ""}`
    [ ] `pizza water`
    ```

